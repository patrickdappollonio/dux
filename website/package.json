{
  "name": "getdux-website",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "scripts": {
    "prep": "node scripts/copy-install.mjs && node scripts/fetch-contributors.mjs && node scripts/generate-webp.mjs",
    "predev": "npm run prep",
    "dev": "astro dev",
    "prestart": "npm run prep",
    "start": "astro dev",
    "build": "npm run prep && npm run test:figure && astro build && node scripts/verify-figure.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "contributors": "node scripts/fetch-contributors.mjs",
    "test": "vitest run",
    "test:figure": "vitest run src/figure",
    "test:search": "node scripts/verify-search-index.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.1",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/react": "^6.0.2",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.3",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.3",
    "astro-pagefind": "^2.0.1",
    "pagefind": "^1.5.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "remark-gemoji": "^8.0.0",
    "sharp": "^0.35.3",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "vitest": "^4.1.8"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "fsevents@2.3.3": true
  }
}
