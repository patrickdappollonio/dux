<style>
  /* Every rule is an OVERRIDE on tiles that are visible by default, so with no
     `:has()` support, or no stylesheet at all, the reader gets the whole grid.
     Nothing here can hide a tile by failing.

     Anchored on `.feature-tile`, never on the bare attribute: Astro scopes a
     selector by hanging its component id off a class or an element, and a lone
     `[data-surface="web"]` picks up no id and ships as a page-wide rule.

     The semantics are the maintainer's: TERMINAL means the terminal ones plus
     the ones that work in both, WEB the same on its side, and BOTH means only
     the ones that work in both. So the two surface filters ANSWER "what can I
     do here", while BOTH answers "what is the same wherever I am". */
  /* Hidden means faded and gone from the flow, not just gone. `display` cannot
     normally be transitioned, so the tile animates its opacity and scale while
     `transition-behavior: allow-discrete` holds `display` until the fade has
     finished. Going the other way, `@starting-style` gives the browser a state
     to animate FROM, otherwise a tile that returns simply appears.

     If either of those is unsupported the tile still hides and shows, just
     instantly, which is exactly what it did before. */
  .feature-tile {
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      display 180ms allow-discrete;
  }

  @starting-style {
    .feature-tile {
      opacity: 0;
      transform: scale(0.97);
    }
  }

  .tile-filter-scope:has(.tile-filter__box[value="terminal"]:checked)
    .feature-tile[data-surface="web"],
  .tile-filter-scope:has(.tile-filter__box[value="web"]:checked)
    .feature-tile[data-surface="terminal"],
  .tile-filter-scope:has(.tile-filter__box[value="both"]:checked)
    .feature-tile:not([data-surface="both"]) {
    opacity: 0;
    transform: scale(0.97);
    display: none;
  }

  /* Movement is decoration here: the filter is what matters and it still works
     instantly. Anyone who asked for less motion gets an instant swap with no
     transition. */
  @media (prefers-reduced-motion: reduce) {
    .feature-tile {
      transition: none;
    }
  }

  /* The input stays the accessible control and keeps focus and keyboard
     handling; it is only visually replaced by the chip wrapping it. */
  .tile-filter__box {
    position: absolute;
    width: 1px;
    height: 1px;
    opacity: 0;
    pointer-events: none;
  }

  .tile-filter__chip {
    cursor: pointer;
    user-select: none;
  }

  /* Selected state is a filled chip, not just a colour swap, so it survives a
     colour-blind reader and a greyscale screenshot. */
  .tile-filter__chip:has(.tile-filter__box:checked) {
    border-color: var(--color-accent);
    background: color-mix(in oklab, var(--color-accent) 18%, transparent);
    color: var(--color-text);
  }

  .tile-filter__chip:has(.tile-filter__box:focus-visible) {
    outline: 2px solid var(--color-accent);
    outline-offset: 2px;
  }
</style>

<script>
  // At most one filter chip on at a time. Clicking the active one clears it,
  // which is the checkbox's own behaviour and the reason these are checkboxes.
  document.querySelectorAll(".tile-filter__box").forEach((box) => {
    box.addEventListener("change", () => {
      if (!(box instanceof HTMLInputElement) || !box.checked) return;
      document.querySelectorAll(".tile-filter__box").forEach((other) => {
        if (other !== box && other instanceof HTMLInputElement) other.checked = false;
      });
    });
  });
</script>
