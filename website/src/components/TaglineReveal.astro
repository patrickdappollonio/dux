---
// The tagline, read one word at a time as it crosses the middle of the screen.
//
// The words are split at BUILD time (src/lib/tagline.ts), so the shipped HTML
// contains the sentence. Nothing here rewrites text in the browser, which means
// a crawler, a reader with scripts off, and a screen reader all get the two
// lines as ordinary prose. The reveal is the only thing the script adds, and it
// only applies once initReveal has armed the section: the muted word colour
// hangs off `is-armed`, so an unarmed page renders at full colour.
import { taglineLines } from "../lib/tagline";

const lines = taglineLines();
---

<section class="reveal py-20 sm:py-28" data-reveal data-tagline>
  <div class="container-app">
    <p class="heading max-w-[680px] text-balance text-4xl font-bold leading-[1.15] tracking-tight sm:text-5xl lg:text-6xl">
      {
        lines.map((line, lineIndex) => (
          <span class="block">
            {line.words.map((word, wordIndex) => (
              <>
                <span class="tagline-word">{word}</span>
                {wordIndex < line.words.length - 1 && " "}
              </>
            ))}
            {lineIndex < lines.length - 1 && " "}
          </span>
        ))
      }
    </p>
  </div>
</section>

{/* One module owns arming and revealing both, so a section can never be hidden
    by a script that then fails to show it again. initReveal arms first, and the
    muted word colour hangs off that same class, so a settled section renders its
    words at full colour with nothing left to do. */}
<script>
  import { initReveal } from "../lib/reveal";
  import { initTagline } from "../lib/tagline";

  initReveal();
  initTagline();
</script>
