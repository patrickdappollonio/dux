---
// Build-time download counters, sized to sit under the install widget. A counter
// whose lookup failed is dropped and an all-failed strip renders nothing. The
// hero states the same totals as one line; this is the breakdown.
import { getReleaseDownloads, getNpmTotal, formatCount } from "../lib/stats";

const repo = "patrickdappollonio/dux";
const pkg = "@patrickdappollonio/dux";

const [downloads, npm] = await Promise.all([
  getReleaseDownloads(repo),
  getNpmTotal(pkg),
]);

interface Stat {
  value: string;
  label: string;
  note: string;
  total?: boolean;
}
const stats: Stat[] = [];
if (downloads !== null) {
  stats.push({
    value: formatCount(downloads),
    label: "Downloads",
    note: "GitHub + Homebrew",
  });
}
if (npm !== null) {
  stats.push({
    value: formatCount(npm),
    label: "npm",
    note: "all time",
  });
}
// Combined total, shown only when both sources are present. The "=" beside it
// acts as the separator. formatCount keeps it friendly (e.g. 1.2k).
if (downloads !== null && npm !== null) {
  stats.push({
    value: formatCount(downloads + npm),
    label: "Total",
    note: "downloads + npm",
    total: true,
  });
}
---

{/* Rendered unconditionally, unlike the counters below it, which disappear when
    the stats fetch fails: how to START dux must not depend on whether GitHub
    answered. No keybinding is printed: every binding in dux is user-configurable,
    so the in-app help overlay is the authority and the palette command name is
    the stable thing to name. */}
<p
  class="mt-4 rounded-lg border border-[color:var(--color-border-soft)] bg-[color:var(--color-panel)]/40 px-4 py-3 text-center text-sm leading-relaxed text-[color:var(--color-muted)] backdrop-blur"
>
  <span class="mono text-[color:var(--color-text)]">dux</span> for the terminal, <span class="mono text-[color:var(--color-text)]">dux server</span> for the browser. Already running?{" "}
  <span class="mono text-[color:var(--color-text)]">start-web-server</span> in the palette hands it over, live, and{" "}
  <span class="mono text-[color:var(--color-text)]">start-background-server</span> serves the browser without giving up the terminal at all.
</p>

{
  stats.length > 0 && (
    <dl class="mt-4 flex flex-wrap items-stretch justify-center gap-x-4 gap-y-3 rounded-lg border border-[color:var(--color-border-soft)] bg-[color:var(--color-panel)]/40 px-4 py-3 backdrop-blur">
      {stats.map((s, i) => (
        <>
          {i > 0 &&
            (s.total ? (
              <div
                aria-hidden="true"
                class="heading self-start text-xl font-bold leading-none text-[color:var(--color-border)] sm:text-2xl"
              >
                =
              </div>
            ) : (
              <div class="w-px self-stretch bg-[color:var(--color-border)]" />
            ))}
          <div class="text-center">
            <dt class="heading text-xl font-bold leading-none tracking-tight text-[color:var(--color-accent)] sm:text-2xl">
              {s.value}
            </dt>
            <dd class="mt-1 text-[10px] font-medium uppercase tracking-wider text-[color:var(--color-muted)]">
              {s.label}
            </dd>
            <dd class="text-[9px] text-[color:var(--color-dim)]">{s.note}</dd>
          </div>
        </>
      ))}
    </dl>
  )
}
