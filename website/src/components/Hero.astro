---
// The landing page's one job is getting a visitor to install dux, so the hero
// carries one primary button and nothing competing with it.
//
// WHAT IS DELIBERATELY NOT HERE.
//
// The "Star on GitHub" ghost BUTTON: a second button beside the install one
// splits the single act this page is asking for. Starring the repo still has a
// home, as the quiet text link under the button, because nothing else on the
// page offers it (the header carries no star count; GhStars is otherwise only
// used by the recommended-tools cards). The "watch the demo" link: the demo is
// no longer somewhere else to go, it is the hero's own visual, one scroll below
// the copy.
//
// The install widget used to sit in a right-hand column here. It still exists,
// unchanged, in the install section at the bottom of the page, which is where a
// reader who has been convinced is heading anyway.
import Asciinema from "./Asciinema.astro";
import GhStars from "./GhStars.astro";
import PondRipples from "./PondRipples.astro";
import Stats from "./Stats.astro";
import WhatsNewBadge from "./WhatsNewBadge.astro";
import { getLatestVersion } from "../lib/version";

// Read at build time from the repository's latest published release, so the
// pill cannot go stale. `null` on any lookup failure, in which case the pill
// simply drops the version segment. See src/lib/version.ts for why it is derived
// rather than written down.
const version = await getLatestVersion("patrickdappollonio/dux");
---

<section class="relative overflow-hidden pt-12 pb-16 sm:pt-20 sm:pb-24">
  <div class="absolute inset-0 grid-bg pointer-events-none opacity-60"></div>

  {/* Sits directly on top of the grid. Both overlays are `absolute inset-0`
      and cover the whole hero, so every child that carries content is
      positioned (`relative`) and stacks above them: the copy column, the demo
      section, and the proof strip alike. */}
  <PondRipples />

  <div class="container-app relative">
    <div class="mb-5 flex flex-wrap items-center gap-3">
      <img
        src="/dux-logo.png"
        alt="dux: a duck conductor with a baton"
        width="56"
        height="56"
        class="h-14 w-14 object-contain drop-shadow-[0_0_24px_rgba(0,212,255,0.25)]"
      />
      <span class="pill">
        <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-success)] animate-pulse"></span>
        {version && <>{version} · </>}macOS + Linux + WSL
      </span>
      <span><WhatsNewBadge /></span>
    </div>

    {/* 680px is a layout width, not a font size: it is the measure the headline
        and the paragraph under it are set to, so the two share an edge and the
        line breaks land where the copy means them to. */}
    <h1
      class="heading heading-gradient mt-5 max-w-[680px] text-balance text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl"
    >
      {/* Two spans rather than a `<br>`: below `sm` the break is dropped and a
          bare `<br>` leaves the two sentences welded together, because Astro
          eats the whitespace around it. The explicit `{" "}` is the separator
          that survives. */}
      <span class="sm:block">Run a whole team of coding agents.</span>{" "}
      <span class="sm:block">From one terminal, or your phone.</span>
    </h1>

    <p class="mt-6 max-w-[680px] text-pretty text-base leading-relaxed text-[color:var(--color-muted)] sm:text-lg">
      <strong class="text-[color:var(--color-text)]">dux</strong> runs Claude, Codex, Copilot,
      OpenCode or any CLI you like, each in its own git worktree, side by side. One engine,
      a terminal UI and a web UI, and the same agents whichever one you open.
    </p>

    <div class="mt-8 flex flex-wrap items-center gap-3">
      <a href="#install" class="btn-primary active:scale-[0.98]">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <polyline points="8 17 12 21 16 17"></polyline>
          <line x1="12" y1="12" x2="12" y2="21"></line>
          <path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"></path>
        </svg>
        Install dux
      </a>
      {/* The pronunciation, parked beside the button rather than in the
          headline's way. It is a nice thing to know and nothing depends on it. */}
      <span class="text-sm text-[color:var(--color-dim)]">
        (pronounced "<em>dooks</em>")
      </span>
    </div>

    {/* The secondary ask, under the primary one rather than beside it, and a
        text link rather than a button so it cannot compete with the install
        click. The star count comes along because a number is the reason to
        press it. */}
    <div class="mt-4">
      <a
        href="https://github.com/patrickdappollonio/dux"
        target="_blank"
        rel="noopener"
        class="inline-flex items-center gap-2 text-sm text-[color:var(--color-muted)] hover:text-[color:var(--color-accent)]"
      >
        Star on GitHub
        <GhStars repo="patrickdappollonio/dux" />
      </a>
    </div>

    {/* Two columns, so this list only ever grows by an EVEN number or the
        last row goes ragged. It is six items; make it eight. */}
    <ul class="mt-8 grid max-w-[680px] grid-cols-2 gap-x-6 gap-y-2 text-xs text-[color:var(--color-dim)] sm:text-sm">
      <li class="flex items-center gap-2"><span class="text-[color:var(--color-success)]">✓</span> Claude, Codex, Copilot, OpenCode</li>
      <li class="flex items-center gap-2"><span class="text-[color:var(--color-success)]">✓</span> Any CLI as a provider</li>
      <li class="flex items-center gap-2"><span class="text-[color:var(--color-success)]">✓</span> Git worktree per agent</li>
      <li class="flex items-center gap-2"><span class="text-[color:var(--color-success)]">✓</span> Full git staging area</li>
      <li class="flex items-center gap-2"><span class="text-[color:var(--color-success)]">✓</span> Terminal UI and web UI, one engine</li>
      <li class="flex items-center gap-2"><span class="text-[color:var(--color-success)]">✓</span> Same workspace from your phone</li>
    </ul>
  </div>

  {/* The demo is the hero's visual. It keeps its own `id="demo"` anchor, so the
      header's Demo link still lands on it. `relative` is not decoration: the
      grid and the ripples above are `absolute inset-0` over the whole hero, and
      an unpositioned section would be painted under both of them. */}
  <Asciinema spacing="relative pt-14 pb-0 sm:pt-16" />

  {/* The proof strip: how to start dux, and the download counters, which drop
      themselves when the lookup fails. */}
  <div class="container-app relative mt-2">
    <div class="mx-auto max-w-3xl">
      <Stats />
    </div>
  </div>
</section>
