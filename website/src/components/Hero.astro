---
import WhatsNewBadge from "./WhatsNewBadge.astro";
import {
  fallbackBackgroundImage,
  fallbackBackgroundPosition,
  fallbackBackgroundSize,
  inkCss,
} from "../lib/heroFleet";
import { getReleaseDownloads, getNpmTotal, formatCount } from "../lib/stats";
import { getLatestVersion } from "../lib/version";

// Read at build time from the repository's latest published release, so the
// pill cannot go stale. `null` on any lookup failure, in which case the pill
// does not render. See src/lib/version.ts for why it is derived rather than
// written down.
const version = await getLatestVersion("patrickdappollonio/dux");

// Build-time social proof, split the same way the install section's counters
// are: where the counters come from, then the total. Either half may fail, so
// each segment renders only when its own lookup resolved and the total only
// when both did, leaving no hole either way.
const [downloads, npm] = await Promise.all([
  getReleaseDownloads("patrickdappollonio/dux"),
  getNpmTotal("@patrickdappollonio/dux"),
]);
const installSegments: string[] = [];
if (downloads !== null)
  installSegments.push(`${formatCount(downloads)} GitHub + Homebrew`);
if (npm !== null) installSegments.push(`${formatCount(npm)} npm`);
if (downloads !== null && npm !== null)
  installSegments.push(`${formatCount(downloads + npm)} installs total`);

// Generated rather than written down, so the layer the canvas crossfades over
// cannot drift from the shader it is standing in for.
const fallback = [
  `background-color: ${inkCss()}`,
  `background-image: ${fallbackBackgroundImage("--hero-fold-h")}`,
  `background-size: ${fallbackBackgroundSize()}`,
  `background-position: ${fallbackBackgroundPosition("--hero-fold-h")}`,
].join("; ");
---

<section class="hero-fold flex items-end" data-hero>
  <div class="hero-base" aria-hidden="true" style={fallback}></div>
  {/* The copy carries the whole meaning; the fleet is decoration. */}
  <canvas data-hero-canvas aria-hidden="true"></canvas>
  <div class="hero-scrim" aria-hidden="true"></div>

  <div class="container-app hero-copy pt-16 pb-20 sm:pt-24 sm:pb-24">
    <div class="hero-column">
      <div class="mb-7 flex flex-wrap items-center gap-3">
        <img
          src="/dux-logo.png"
          alt="dux: a duck conductor with a baton"
          width="56"
          height="56"
          class="h-14 w-14 object-contain drop-shadow-[0_0_24px_rgba(0,212,255,0.25)]"
        />
        {/* Platforms moved down to the line under the button, so the pill is
            the version and nothing else. */}
        {
          version && (
            <span class="pill">
              <span class="h-1.5 w-1.5 rounded-full bg-[color:var(--color-success)] animate-pulse" />
              {version}
            </span>
          )
        }
        <WhatsNewBadge />
      </div>

      <h1 class="hero-headline">
        {/* The full stop used to sit outside the accent span, which is an
            inline-block and therefore an atomic inline: at narrow widths the
            browser stranded the dot on a line of its own. A word joiner does
            not fix that, measured rather than assumed, because at those widths
            no other break opportunity fits and the browser breaks anyway.
            Binding the whole phrase into one nowrap unit does not fix it
            either: "proper office." is wider than a 320px column, so it
            overflowed the viewport instead.

            So each word is its own accent unit, which restores the break
            between them, and the dot lives inside the second unit's nowrap box
            where nothing can strand it. Each unit's underline is anchored to a
            wrapper holding only its word, so the rule never reaches under the
            dot; the leading unit's rule is extended by one character cell (the
            headline is monospaced, so 1ch is exactly the space's advance) and
            the two bars meet as the single continuous rule the design asks
            for. The cost, stated rather than discovered: when the two words do
            land on different lines, the first bar hangs one cell past
            "proper". */}
        Your AI agents deserve a <span class="hero-mark"
          ><span class="hero-mark-words"
            ><span class="hero-mark-word">proper</span><span
              aria-hidden="true"
              class="hero-mark-rule hero-mark-rule-lead"></span></span
          ></span
        > <span class="hero-mark"
          ><span class="hero-mark-words"
            ><span class="hero-mark-word">office</span><span
              aria-hidden="true"
              class="hero-mark-rule"></span></span
          >.</span
        >
      </h1>

      <p class="hero-sub">
        dux runs multiple AI coding agents in parallel, each in its own git
        worktree. A terminal UI and a web UI over one engine, whichever you
        happen to be looking at.
      </p>

      <div class="hero-cta">
        <a class="btn-primary" href="#install">
          <svg
            width="14"
            height="14"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <polyline points="8 17 12 21 16 17"></polyline>
            <line x1="12" y1="12" x2="12" y2="21"></line>
            <path d="M20.88 18.09A5 5 0 0 0 18 9h-1.26A8 8 0 1 0 3 16.29"></path>
          </svg>
          Install dux
        </a>
        <span class="hero-meta">
          <span class="hero-plat">macOS + Linux + WSL</span>
          {
            installSegments.map((seg) => (
              <span class="hero-seg">
                <span class="hero-plat" aria-hidden="true">
                  &#183;
                </span>
                <span class="hero-plat">{seg}</span>
              </span>
            ))
          }
        </span>
      </div>
    </div>
  </div>
</section>

<style>
  /* The hero owns the fold: the viewport minus the sticky header (h-14). The
     custom property is the CSS layer's idea of the hero's height, which the
     scene overwrites with the measured one at mount; this default is what a
     scripts-off visit gets, where there is no shader to disagree with it. */
  .hero-fold {
    position: relative;
    min-height: calc(100svh - 3.5rem);
    overflow: hidden;
    isolation: isolate;
    --hero-fold-h: calc(100svh - 3.5rem);
  }

  .hero-fold canvas {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    display: block;
    z-index: 0;
    /* Crossfades in over the CSS layer on its first rendered frame, so the
       handoff is not a pop. With no script it never arrives and the CSS layer
       simply IS the background; with WebGL refused the canvas is hidden
       outright, same result. */
    opacity: 0;
    transition: opacity 260ms ease;
  }

  .hero-fold canvas.is-live {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-fold canvas {
      transition: none;
    }
  }

  /* The pure-CSS rendition of the background pass, painted under the canvas.
     Its gradients are generated from the same field list the shader is, so the
     two agree on ink, anchors, tones, amplitudes and lattice pitch. */
  .hero-base {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .hero-scrim {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      linear-gradient(
        to top,
        color-mix(in oklab, var(--color-ink) 96%, transparent) 0%,
        color-mix(in oklab, var(--color-ink) 84%, transparent) 34%,
        transparent 66%
      ),
      linear-gradient(
        to right,
        color-mix(in oklab, var(--color-ink) 82%, transparent) 0%,
        color-mix(in oklab, var(--color-ink) 40%, transparent) 30%,
        transparent 52%
      );
  }

  .hero-copy {
    position: relative;
    z-index: 2;
    width: 100%;
  }

  .hero-column {
    max-width: 37rem;
  }

  /* Sizing lives here rather than in Tailwind arbitrary values: a `clamp()` or
     `calc()` with spaces inside a class name is silently dropped. */
  .hero-headline {
    font-family: var(--font-display);
    letter-spacing: -0.028em;
    text-wrap: balance;
    line-height: 1.03;
    font-weight: 700;
    font-size: clamp(2.35rem, 5.4vw, 4.2rem);
    color: var(--color-text);
  }

  .hero-mark {
    display: inline-block;
    white-space: nowrap;
  }

  /* The underline's containing block: the words alone, so the rule cannot reach
     under the full stop that shares the nowrap unit with them. */
  .hero-mark-words {
    position: relative;
    display: inline-block;
  }

  .hero-mark-word {
    position: relative;
    z-index: 1;
    color: var(--color-accent);
  }

  .hero-mark-rule {
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.05em;
    height: 0.14em;
    transform: skewX(-12deg);
    background: color-mix(in oklab, var(--color-accent) 22%, transparent);
  }

  /* Bridges the space between the two accent units so the underline reads as
     one bar. `ch` is the advance of a character cell, which in a monospaced
     face is exactly a space. */
  .hero-mark-rule-lead {
    right: -1ch;
  }

  .hero-sub {
    text-wrap: balance;
    color: var(--color-text);
    font-size: clamp(1.05rem, 1.45vw, 1.3rem);
    line-height: 1.6;
    margin-top: 1.5rem;
  }

  .hero-cta {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 1rem;
    margin-top: 2.25rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
  }

  /* The separator travels with the segment it introduces, so a wrap can never
     leave a lone middot hanging at the end of a line. */
  .hero-seg {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
  }

  .hero-plat {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.06em;
    color: var(--color-muted);
  }
</style>

<script>
  import { mountHeroScene } from "../lib/heroScene";

  const hero = document.querySelector<HTMLElement>("[data-hero]");
  const canvas = hero?.querySelector<HTMLCanvasElement>("[data-hero-canvas]");
  // A refused context leaves the CSS layer as the background, which is the same
  // thing a scripts-off visitor gets.
  const scene = hero && canvas ? mountHeroScene(hero, canvas) : null;
  if (canvas && !scene) {
    canvas.style.display = "none";
  }
  // The site has no view transitions today, so this never fires; it is the
  // cheap insurance that adding them later does not leak a renderer per swap.
  document.addEventListener("astro:before-swap", () => scene?.destroy(), {
    once: true,
  });
</script>
