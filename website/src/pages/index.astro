---
// The landing page. It has one job: get the visitor to install dux.
//
// The order below is that job, in order. The hero says what dux is and shows it
// running; RealCLI says what problem that solves; the tagline states the change
// in one breath; the benefits are five doors into the catalogue on /features;
// the tour shows the shape of the thing; server mode is the reach; the FAQ
// clears the last objections; and install is the ask, with the newsletter and
// the blog and contributors tail after it.
//
// The feature catalogue and the config sample are not gone. They are the whole
// of /features, which is where a reader who wants to browse is better served.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import RealCLI from "../components/RealCLI.astro";
import TaglineReveal from "../components/TaglineReveal.astro";
import Benefits from "../components/Benefits.astro";
import Manifesto from "../components/Manifesto.astro";
import ServerMode from "../components/ServerMode.astro";
import Faq from "../components/Faq.astro";
import InstallSection from "../components/InstallSection.astro";
import Newsletter from "../components/Newsletter.astro";
import LatestPosts from "../components/LatestPosts.astro";
import Contributors from "../components/Contributors.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../lib/site";

// The homepage carries the canonical title and description. Both live in
// lib/site.ts so this page and Layout.astro's fallbacks cannot drift apart.
const title = SITE_TITLE;
const description = SITE_DESCRIPTION;
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <RealCLI />
    <TaglineReveal />
    <Benefits />
    <Manifesto />
    <ServerMode />
    <Faq />
    <InstallSection />
    <Newsletter />
    <LatestPosts />
    <Contributors />
  </main>
  <Footer />
</Layout>
