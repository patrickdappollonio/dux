---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Asciinema from "../components/Asciinema.astro";
import Manifesto from "../components/Manifesto.astro";
import RealCLI from "../components/RealCLI.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import ConfigPeek from "../components/ConfigPeek.astro";
import InstallSection from "../components/InstallSection.astro";
import ServerMode from "../components/ServerMode.astro";
import LatestPosts from "../components/LatestPosts.astro";
import Contributors from "../components/Contributors.astro";
import Newsletter from "../components/Newsletter.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../lib/site";

// The homepage carries the canonical title and description. Both live in
// lib/site.ts so this page and Layout.astro's fallbacks cannot drift apart.
const title = SITE_TITLE;
const description = SITE_DESCRIPTION;
---

<Layout title={title} description={description}>
  <Header />
  <main>
    <Hero />
    <Newsletter />
    <Asciinema />
    <Manifesto />
    <RealCLI />
    <FeatureGrid />
    <ConfigPeek />
    <ServerMode />
    <InstallSection />
    <LatestPosts />
    <Contributors />
  </main>
  <Footer />
</Layout>
