---
// The web-UI figure as its own document, embedded by `Manifesto.astro` on the
// homepage rather than visited: it carries `noindex` and is filtered out of the
// sitemap. Deliberately not `Layout.astro`, because it must load the app's
// stylesheet and not the marketing site's (see `figure.css` for why the two
// cannot share a document). No `client:*` directive anywhere, so the tree renders
// at build time and ships zero JavaScript.
import "../../figure/figure.css";
// The markup is produced by `scripts/render-figure.mjs`, a `prep` step that runs
// before `astro dev` and `astro build` alike. The page reads the artifact.
import figure from "../../figure/figure.html?raw";
---

<!doctype html>
<!-- The app is dark-only; its runtime does this in `main.tsx`. -->
<html lang="en" class="dark" style="color-scheme: dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>dux web UI</title>
  </head>
  <body>
    <div id="root" set:html={figure}></div>
  </body>
</html>
