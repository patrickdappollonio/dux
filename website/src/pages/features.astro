---
// The feature catalogue, which used to live halfway down the homepage.
//
// It moved because the two pages want different things. The homepage has one
// job, which is getting a visitor to install dux, and two dozen tiles in the
// middle of it is a reading assignment rather than an argument. Here the same
// tiles are the whole point: a reader who arrived from a benefit tile, or from
// the header, came to browse. Every tile carries a stable id derived from its
// heading, which is what the homepage's benefit tiles link into.
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import ConfigPeek from "../components/ConfigPeek.astro";
import FeatureGrid from "../components/FeatureGrid.astro";
import Footer from "../components/Footer.astro";

const title = "Features | dux";
const description =
  "Everything dux does: any CLI as a provider, a git worktree per agent, a real staging area with diffs and commits, macros, themes, companion terminals, a web UI you can drive from a phone, and a config file that documents itself.";
---

<Layout title={title} description={description} emitStructuredData={false}>
  <Header />
  <main>
    <section class="pt-12 pb-4 sm:pt-16 sm:pb-6">
      <div class="container-app">
        <span class="pill">▸ features</span>
        <h1 class="heading mt-4 max-w-[680px] text-balance text-4xl font-bold leading-[1.1] tracking-tight sm:text-5xl">
          Everything dux does, on one page.
        </h1>
        <p class="mt-5 max-w-[680px] text-pretty text-base leading-relaxed text-[color:var(--color-muted)] sm:text-lg">
          The tiles below are the whole catalogue, filterable by which front end a feature
          lives in, and the config file underneath them is the one that documents itself.
          Nothing here is a plan or a maybe: it all ships in the binary you install.
        </p>
      </div>
    </section>
    <ConfigPeek />
    <FeatureGrid />
  </main>
  <Footer />
</Layout>
