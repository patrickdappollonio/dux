# The third-party images the container journeys (crates/dux-journeys) and their
# CI workflow (.github/workflows/journeys.yml) use, pinned by digest so a new
# upstream release cannot change what a journey runs against. Both read this
# file; nothing else names these images.
#
# To move one forward:
#   docker buildx imagetools inspect <name>:<tag> | grep -m1 '^Digest:'
# then replace the digest after `@`, and run the journeys. The base image's
# digest is part of the journey image's tag, so changing it builds a new image.
JOURNEY_BASE_IMAGE=archlinux:latest@sha256:b21322c663be387c0ed9cbc7bbbfe18e41633ad4e7b7c77cfad45f128be20040
JOURNEY_NGINX_IMAGE=nginx:1-alpine@sha256:df221db836e1754089190208cee7eeda94f233197056426eda74a43ab1abeac2
JOURNEY_CADDY_IMAGE=caddy:2-alpine@sha256:881bbc60f9986d5ab8e7cfd6cf7e4ef3c9c0439fef2429d035d065577882f028
